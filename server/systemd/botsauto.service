[Unit]
Description=Botsauto — mobile.de alert scraper (één ronde)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=botsauto
WorkingDirectory=/home/botsauto/app/auto-alert
EnvironmentFile=/home/botsauto/app/auto-alert/.env
ExecStart=/home/botsauto/venv/bin/python scraper.py
TimeoutStartSec=600
# Beveiliging
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/botsauto/app/auto-alert
